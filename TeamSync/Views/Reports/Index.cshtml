@{
    ViewData["Title"] = "Reports";
}

<div class="ts-page-header ts-mb-lg">
    <h1 class="ts-headline-lg-mobile md:ts-headline-lg">Reports</h1>
    <p class="ts-body-lg ts-text-secondary">Monitor your groups, students, and project progress</p>
</div>

@if (Model != null)
{
    <!-- Statistics Grid -->
    <div class="ts-dashboard-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div class="ts-dashboard-card">
            <div class="ts-dashboard-card-body">
                <div class="ts-flex ts-items-center ts-justify-between">
                    <div>
                        <div class="ts-label-sm ts-text-secondary">Total Groups</div>
                        <div class="ts-headline-sm" style="color: var(--ts-primary);">@Model.TotalGroups</div>
                    </div>
                    <span class="material-symbols-outlined" style="font-size: 32px; color: var(--ts-primary); opacity: 0.3;">folder_shared</span>
                </div>
            </div>
        </div>

        <div class="ts-dashboard-card">
            <div class="ts-dashboard-card-body">
                <div class="ts-flex ts-items-center ts-justify-between">
                    <div>
                        <div class="ts-label-sm ts-text-secondary">Students</div>
                        <div class="ts-headline-sm" style="color: var(--ts-success);">@Model.TotalStudents</div>
                    </div>
                    <span class="material-symbols-outlined" style="font-size: 32px; color: var(--ts-success); opacity: 0.3;">people</span>
                </div>
            </div>
        </div>

        <div class="ts-dashboard-card">
            <div class="ts-dashboard-card-body">
                <div class="ts-flex ts-items-center ts-justify-between">
                    <div>
                        <div class="ts-label-sm ts-text-secondary">Tasks</div>
                        <div class="ts-headline-sm" style="color: var(--ts-warning);">@Model.TotalTasks</div>
                    </div>
                    <span class="material-symbols-outlined" style="font-size: 32px; color: var(--ts-warning); opacity: 0.3;">assignment</span>
                </div>
            </div>
        </div>

        <div class="ts-dashboard-card">
            <div class="ts-dashboard-card-body">
                <div class="ts-flex ts-items-center ts-justify-between">
                    <div>
                        <div class="ts-label-sm ts-text-secondary">Completed</div>
                        <div class="ts-headline-sm" style="color: var(--ts-info);">@Model.CompletedTasks</div>
                    </div>
                    <span class="material-symbols-outlined" style="font-size: 32px; color: var(--ts-info); opacity: 0.3;">check_circle</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Groups Table -->
    <div class="ts-dashboard-card">
        <div class="ts-dashboard-card-header">
            <h2 class="ts-title-lg">Groups Overview</h2>
        </div>
        <div class="ts-dashboard-card-body">
            @if (Model.Groups != null && Model.Groups.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="ts-table ts-table-striped">
                        <thead>
                            <tr>
                                <th>Group Name</th>
                                <th>Members</th>
                                <th>Tasks</th>
                                <th>Completed</th>
                                <th>Progress</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.Groups)
                            {
                                var completionPercentage = group.TaskCount > 0 
                                    ? (int)Math.Round((double)group.CompletedTaskCount / group.TaskCount * 100)
                                    : 0;

                                <tr>
                                    <td><strong>@group.Name</strong></td>
                                    <td>@group.MemberCount</td>
                                    <td>@group.TaskCount</td>
                                    <td>@group.CompletedTaskCount</td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <div style="flex: 1; height: 8px; background: var(--ts-border); border-radius: 4px; overflow: hidden;">
                                                <div style="height: 100%; background: var(--ts-success); width: @completionPercentage%;"></div>
                                            </div>
                                            <span>@completionPercentage%</span>
                                        </div>
                                    </td>
                                    <td>@group.UpdatedAt?.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <a asp-action="GroupDetails" asp-route-id="@group.Id" class="ts-btn ts-btn-sm ts-btn-primary">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="ts-empty-state">
                    <span class="material-symbols-outlined" style="font-size: 48px; color: var(--ts-border);">folder_open</span>
                    <p class="ts-body-lg ts-text-secondary">No groups found</p>
                </div>
            }
        </div>
    </div>
}
