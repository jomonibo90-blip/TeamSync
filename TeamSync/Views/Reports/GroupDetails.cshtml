@model TeamSync.ViewModels.GroupDetailsReportViewModel
@{
    ViewData["Title"] = "Group Report";
}

<div class="ts-page-header ts-mb-lg">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <a asp-action="Index" class="ts-btn ts-btn-secondary" style="padding: 0.5rem 1rem;">
            <span class="material-symbols-outlined" style="font-size: 20px;">arrow_back</span>
            Back
        </a>
        <div>
            <h1 class="ts-headline-lg-mobile md:ts-headline-lg">@Model.Name</h1>
            <p class="ts-body-lg ts-text-secondary">Detailed group report and progress</p>
        </div>
    </div>
</div>

@if (Model != null)
{
    <!-- Group Info -->
    <div class="ts-dashboard-card ts-mb-lg">
        <div class="ts-dashboard-card-header">
            <h2 class="ts-title-lg">Group Information</h2>
        </div>
        <div class="ts-dashboard-card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                <div>
                    <div class="ts-label-sm ts-text-secondary">Description</div>
                    <p class="ts-body-md">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</p>
                </div>
                <div>
                    <div class="ts-label-sm ts-text-secondary">Created</div>
                    <p class="ts-body-md">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
                <div>
                    <div class="ts-label-sm ts-text-secondary">Members</div>
                    <p class="ts-body-md ts-headline-sm">@(Model.Members?.Count() ?? 0)</p>
                </div>
                <div>
                    <div class="ts-label-sm ts-text-secondary">Tasks</div>
                    <p class="ts-body-md ts-headline-sm">@(Model.TaskCount)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Members List -->
    <div class="ts-dashboard-card ts-mb-lg">
        <div class="ts-dashboard-card-header">
            <h2 class="ts-title-lg">Members</h2>
        </div>
        <div class="ts-dashboard-card-body">
            @if (Model.Members != null && Model.Members.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="ts-table ts-table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>@(member.FirstName) @(member.LastName)</td>
                                    <td>@member.Email</td>
                                    <td><span class="ts-badge">@member.Role</span></td>
                                    <td>@member.JoinedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="ts-text-secondary">No members in this group</p>
            }
        </div>
    </div>

    <!-- Tasks List -->
    <div class="ts-dashboard-card">
        <div class="ts-dashboard-card-header">
            <h2 class="ts-title-lg">Tasks</h2>
        </div>
        <div class="ts-dashboard-card-body">
            @if (Model.Tasks != null && Model.Tasks.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="ts-table ts-table-striped">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Due Date</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model.Tasks)
                            {
                                var statusColor = task.Status switch
                                {
                                    "Completed" => "var(--ts-success)",
                                    "In Progress" => "var(--ts-warning)",
                                    "Pending" => "var(--ts-info)",
                                    _ => "var(--ts-border)"
                                };

                                var priorityColor = task.Priority switch
                                {
                                    3 => "var(--ts-danger)",
                                    2 => "var(--ts-warning)",
                                    1 => "var(--ts-info)",
                                    _ => "var(--ts-border)"
                                };

                                <tr>
                                    <td><strong>@task.Title</strong></td>
                                    <td>
                                        <span class="ts-badge" style="background: @statusColor; color: white;">
                                            @task.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="ts-badge" style="background: @priorityColor; color: white;">
                                            @task.Priority
                                        </span>
                                    </td>
                                    <td>@(task.DueDate?.ToString("MMM dd, yyyy") ?? "No due date")</td>
                                    <td>@task.CreatedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="ts-text-secondary">No tasks in this group</p>
            }
        </div>
    </div>
}
