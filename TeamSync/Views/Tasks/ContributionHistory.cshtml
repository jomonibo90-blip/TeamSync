@model List<TeamSync.Models.ContributionHistory>
@{
    ViewData["Title"] = "Contribution History";
}

<div class="ts-card">
    <div class="ts-card-header">
        <h3 class="ts-title-lg">Contribution History</h3>
    </div>
    <div class="ts-card-body">
        @if (Model == null || !Model.Any())
        {
            <div class="ts-body-sm ts-text-secondary">No history available.</div>
        }
        else
        {
            <ul style="list-style:none; padding:0; margin:0;">
                @foreach (var h in Model)
                {
                    <li style="padding:0.75rem 0; border-bottom:1px dashed var(--ts-border);">
                        <div class="ts-body-sm"><strong>@h.Action</strong> by <em>@h.PerformedById</em> @@ <span class="ts-text-secondary">@h.PerformedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span></div>
                        @if (!string.IsNullOrWhiteSpace(h.Changes))
                        {
                            <div class="ts-body-xs ts-text-secondary" style="margin-top:0.25rem; white-space:pre-wrap;">@h.Changes</div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>