@model TeamSync.ViewModels.TaskEditViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<TeamSync.Models.User> UserManager
@{
    ViewData["Title"] = "Edit Task";
}

<h2>Edit Task</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="GroupId" />

    <div class="ts-form-group">
        <label asp-for="Title" class="ts-label">Title</label>
        <div class="ts-input-wrapper">
            <input asp-for="Title" class="ts-input" />
        </div>
        <span asp-validation-for="Title" class="ts-validation-error"></span>
    </div>

    <div class="ts-form-group">
        <label asp-for="Description" class="ts-label">Description</label>
        <textarea asp-for="Description" class="ts-input" rows="4"></textarea>
        <span asp-validation-for="Description" class="ts-validation-error"></span>
    </div>

    <div class="ts-form-group">
        <label class="ts-label">Assign To (Multi-Select)</label>
        <div class="ts-input-wrapper">
            <div id="assigneeMultiSelect" class="ts-multi-select">
                @if (ViewBag.Members != null)
                {
                    var assignedIds = (ViewBag.AssignedUserIds as List<string>) ?? new List<string>();
                    foreach (var u in (List<TeamSync.Models.User>)ViewBag.Members)
                    {
                        var isProfessor = UserManager.IsInRoleAsync(u, "Professor").Result;
                        if (!isProfessor)
                        {
                            var isChecked = assignedIds.Contains(u.Id);
                            <label class="ts-checkbox-item">
                                <input type="checkbox" name="AssignedUserIds" value="@u.Id" @(isChecked ? "checked" : "") class="ts-checkbox" />
                                <span class="ts-checkbox-label">@u.FirstName @u.LastName (@u.Email)</span>
                            </label>
                        }
                    }
                }
            </div>
        </div>
        <span class="ts-body-xs ts-text-secondary" style="margin-top: 0.5rem; display: block;">Select one or more team members to assign this task</span>
    </div>

    <div class="ts-form-group">
        <label asp-for="StartDate" class="ts-label">Start Date</label>
        <div class="ts-input-wrapper">
            <input asp-for="StartDate" type="date" class="ts-input" />
        </div>
        <span asp-validation-for="StartDate" class="ts-validation-error"></span>
    </div>

    <div class="ts-form-group">
        <label asp-for="DueDate" class="ts-label">Due Date</label>
        <div class="ts-input-wrapper">
            <input asp-for="DueDate" type="date" class="ts-input" />
        </div>
        <span asp-validation-for="DueDate" class="ts-validation-error"></span>
    </div>

    <div class="ts-form-group">
        <label asp-for="Priority" class="ts-label">Priority</label>
        <div class="ts-input-wrapper">
            <select asp-for="Priority" class="ts-input">
                @if (Model.Priority == 1)
                {
                    <option value="1" selected="selected">Low</option>
                }
                else
                {
                    <option value="1">Low</option>
                }

                @if (Model.Priority == 2)
                {
                    <option value="2" selected="selected">Medium</option>
                }
                else
                {
                    <option value="2">Medium</option>
                }

                @if (Model.Priority == 3)
                {
                    <option value="3" selected="selected">High</option>
                }
                else
                {
                    <option value="3">High</option>
                }
            </select>
        </div>
    </div>

    <div class="ts-mt-lg">
        <button type="submit" class="ts-btn ts-btn-primary">Save Changes</button>
        <a asp-action="Details" asp-controller="Tasks" asp-route-id="@Model.Id" class="ts-btn ts-btn-secondary" style="margin-left:8px;">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .ts-multi-select {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            padding: 1rem;
            background: var(--ts-surface-container);
            border-radius: var(--ts-radius-md);
            border: 1px solid var(--ts-border);
        }

        .ts-checkbox-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 0.25rem;
            transition: background-color 0.2s ease;
        }

        .ts-checkbox-item:hover {
            background-color: var(--ts-surface);
        }

        .ts-checkbox-item input[type="checkbox"] {
            cursor: pointer;
        }

        .ts-checkbox-label {
            cursor: pointer;
            flex: 1;
        }
    </style>
}
