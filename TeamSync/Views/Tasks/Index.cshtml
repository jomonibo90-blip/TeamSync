@model List<TeamSync.ViewModels.TaskListItemViewModel>
@{
    ViewData["Title"] = "Task Management";
    var activeStatus = (ViewBag.ActiveStatus as string) ?? "All";
    var canCreateTask = (ViewBag.CanCreateTask as bool?) ?? false;
    var canRequestTask = (ViewBag.CanRequestTask as bool?) ?? false;

    string StatusClass(string status) => status switch
    {
        "Requested" => "ts-status-requested",
        "Rejected" => "ts-status-rejected",
        "Completed" => "ts-status-completed",
        _ => "ts-status-pending"
    };

    string PriorityClass(int p) => p switch
    {
        3 => "ts-priority-high",
        2 => "ts-priority-medium",
        _ => "ts-priority-low"
    };

    string PriorityLabel(int p) => p switch
    {
        3 => "HIGH",
        2 => "MEDIUM",
        _ => "LOW"
    };

    var currentUserId = (ViewBag.CurrentUserId as string) ?? string.Empty;
}

<div class="ts-task-page-header">
    <div>
        <h1 class="ts-headline-lg-mobile md:ts-headline-lg">Task Management</h1>
        <p class="ts-body-lg ts-text-secondary">Manage assigned and requested tasks for accountability.</p>
    </div>
    <div class="ts-task-actions">
        <a href="#taskFilters" class="ts-btn ts-btn-secondary">
            <span class="material-symbols-outlined" style="font-size:18px;">tune</span> Filter
        </a>

        @if (canCreateTask)
        {
            <a asp-controller="Tasks" asp-action="SelectGroup" asp-route-mode="create" class="ts-btn ts-btn-primary">
                <span class="material-symbols-outlined" style="font-size:18px;">add</span> New Task
            </a>
        }
        else if (canRequestTask)
        {
            <a asp-controller="Tasks" asp-action="SelectGroup" asp-route-mode="request" class="ts-btn ts-btn-primary">
                <span class="material-symbols-outlined" style="font-size:18px;">assignment</span> Request Task
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="ts-alert" style="background: rgba(25,135,84,0.1); color: var(--ts-success); border: 1px solid rgba(25,135,84,0.2);">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="ts-alert ts-alert-error">
        @TempData["ErrorMessage"]
    </div>
}

<div id="taskFilters" class="ts-filter-chip-row">
    @foreach (var status in new[] { "All", "Requested", "Pending", "Completed", "Rejected" })
    {
        var active = string.Equals(activeStatus, status, StringComparison.OrdinalIgnoreCase);
        <a asp-action="Index" asp-route-status="@(status == "All" ? null : status)" class="ts-filter-chip @(active ? "active" : "")">@status</a>
    }
</div>

@if (!Model.Any())
{
    <div class="ts-card ts-mt-md">
        <div class="ts-card-body ts-empty">No tasks found for this filter.</div>
    </div>
}
else
{
    <div class="ts-task-list">
        @foreach (var t in Model)
        {
            var assigneeInitial = string.IsNullOrWhiteSpace(t.AssignedToName) ? "U" : t.AssignedToName.Trim()[0].ToString().ToUpperInvariant();
            <article class="ts-task-item">
                <div class="ts-task-item-top">
                    <div class="ts-task-title-wrap">
                        <h3 class="ts-task-title">
                            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="ts-link">@t.Title</a>
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(t.Description))
                        {
                            <p class="ts-task-desc">@t.Description</p>
                        }
                    </div>
                    <span class="ts-badge @PriorityClass(t.Priority)">@PriorityLabel(t.Priority)</span>
                </div>

                <div class="ts-task-item-meta">
                    <span class="ts-status @StatusClass(t.Status)">@t.Status</span>
                    <span class="ts-task-date @(t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.UtcNow.Date ? "ts-task-date-overdue" : "")">
                        <span class="material-symbols-outlined" style="font-size:16px;">calendar_month</span>
                        @(t.DueDate?.ToString("MMM dd") ?? "No due date")
                    </span>
                </div>

                <div class="ts-task-item-footer">
                    <div class="ts-task-assignee">
                        <span class="ts-avatar-sm">@assigneeInitial</span>
                        <span class="ts-body-sm">@(t.AssignedToName ?? "Unassigned")</span>
                    </div>
                    <div class="ts-task-links">
                        <span class="ts-body-sm ts-text-secondary">@(t.GroupName ?? "No project")</span>

                        @* Card-level action buttons: Start / Request Review / Approve/Reject *@
                        @if (!string.IsNullOrEmpty(currentUserId) && currentUserId == t.AssignedToId)
                        {
                            if (t.Status == "Pending")
                            {
                                <form asp-action="SetInProgress" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:8px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="ts-btn ts-btn-sm ts-btn-primary">Start</button>
                                </form>
                            }
                            else if (t.Status == "InProgress")
                            {
                                <form asp-action="RequestReview" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:8px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">Request Review</button>
                                </form>
                            }
                        }

                        @* Approvers can act on ReviewRequested tasks directly from cards *@
                        @if (t.Status == "ReviewRequested" && t.CanApprove)
                        {
                            var approveLabel = t.IsLeadForCurrentUser && !t.IsProfessorForCurrentUser ? "Lead Approve" : "Finalize";
                            <form asp-action="ApproveCompletion" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:8px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="ts-btn ts-btn-sm ts-btn-success">@approveLabel</button>
                            </form>
                            <form asp-action="RejectCompletion" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:4px;" onsubmit="return confirm('Reject completion?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">Reject</button>
                            </form>
                        }

                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="ts-link">Open</a>
                    </div>
                </div>
            </article>
        }
    </div>
}

@section Scripts {
    <script>
        // Disable submit buttons and show loading state to prevent double submits
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (form.classList && form.classList.contains('js-disable-on-submit')) {
                var btns = form.querySelectorAll('button[type=submit]');
                btns.forEach(function (b) { b.disabled = true; b.dataset.origHtml = b.innerHTML; b.innerHTML = 'Processing...'; });
            }
        });
    </script>
}
