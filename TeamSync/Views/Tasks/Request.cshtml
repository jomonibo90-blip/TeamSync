@model TeamSync.ViewModels.TaskRequestViewModel
@{
    ViewData["Title"] = "Request Task";
}

<h2>Request Task</h2>

<form asp-action="RequestTask" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="GroupId" />

    <div class="ts-form-group">
        <label asp-for="Title" class="ts-label">Title</label>
        <div class="ts-input-wrapper">
            <input asp-for="Title" class="ts-input" />
        </div>
        <span asp-validation-for="Title" class="ts-validation-error"></span>
    </div>

    <div class="ts-form-group">
        <label asp-for="Description" class="ts-label">Description</label>
        <textarea asp-for="Description" class="ts-input" rows="4"></textarea>
        <span asp-validation-for="Description" class="ts-validation-error"></span>
    </div>

    <div class="ts-mt-lg">
        <button type="submit" class="ts-btn ts-btn-primary">Submit Request</button>
        <a asp-action="Details" asp-controller="Groups" asp-route-id="@Model.GroupId" class="ts-btn ts-btn-secondary" style="margin-left:8px;">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
