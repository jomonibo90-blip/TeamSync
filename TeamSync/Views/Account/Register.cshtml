@model TeamSync.ViewModels.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account - TeamSync</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/teamsync.css" asp-append-version="true" />
</head>
<body>
    <main class="ts-auth-container">
        <div class="ts-auth-card">
            <!-- Brand Header -->
     <div class="ts-auth-brand">
   <h1 class="ts-display-lg">
                 <span class="material-symbols-outlined icon-fill" style="font-size: 40px;">sync</span>
       TeamSync
     </h1>
    <p class="ts-body-md">Team accountability, simplified.</p>
            </div>

<!-- Registration Card -->
 <div class="ts-card">
           <div class="ts-card-body" style="padding: 1.5rem 2rem;">
        <div style="border-bottom: 1px solid var(--ts-border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
          <h2 class="ts-title-lg" style="margin: 0;">Create Account</h2>
           <p class="ts-body-sm ts-text-secondary ts-mt-sm" style="margin: 0.5rem 0 0 0;">Please fill in your details to register.</p>
 </div>

      <form asp-action="Register" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
             {
                 <div class="ts-alert ts-alert-error">
<div asp-validation-summary="All"></div>
       </div>
   }

             <!-- First Name -->
          <div class="ts-form-group">
              <label asp-for="FirstName" class="ts-label">First Name</label>
          <div class="ts-input-wrapper">
       <span class="material-symbols-outlined ts-input-icon">person</span>
  <input asp-for="FirstName" type="text" class="ts-input ts-input-with-icon" placeholder="John" />
           </div>
              <span asp-validation-for="FirstName" class="ts-validation-error"></span>
   </div>

      <!-- Last Name -->
    <div class="ts-form-group">
           <label asp-for="LastName" class="ts-label">Last Name</label>
      <div class="ts-input-wrapper">
               <span class="material-symbols-outlined ts-input-icon">person</span>
   <input asp-for="LastName" type="text" class="ts-input ts-input-with-icon" placeholder="Doe" />
       </div>
     <span asp-validation-for="LastName" class="ts-validation-error"></span>
      </div>

   <!-- Email Input -->
<div class="ts-form-group">
  <label asp-for="Email" class="ts-label">University Email</label>
      <div class="ts-input-wrapper">
    <span class="material-symbols-outlined ts-input-icon">mail</span>
 <input asp-for="Email" type="email" class="ts-input ts-input-with-icon" placeholder="user@example.com" />
   </div>
     <span asp-validation-for="Email" class="ts-validation-error"></span>
       </div>

      <!-- Student ID -->
            <div class="ts-form-group">
       <label asp-for="StudentId" class="ts-label">Student ID</label>
     <div class="ts-input-wrapper">
         <span class="material-symbols-outlined ts-input-icon">badge</span>
       <input asp-for="StudentId" type="text" class="ts-input ts-input-with-icon" placeholder="STU001" />
             </div>
          <span asp-validation-for="StudentId" class="ts-validation-error"></span>
 </div>

          <!-- Password Input -->
  <div class="ts-form-group">
         <label asp-for="Password" class="ts-label">Password</label>
   <div class="ts-input-wrapper">
           <span class="material-symbols-outlined ts-input-icon">lock</span>
       <input asp-for="Password" type="password" class="ts-input ts-input-with-icon" placeholder="••••••••" />
     </div>
       <p class="ts-body-sm ts-text-secondary" style="font-size: 11px; margin-top: 0.25rem;">Must be at least 8 characters with uppercase, lowercase, and numbers.</p>
       <span asp-validation-for="Password" class="ts-validation-error"></span>
      </div>

               <!-- Confirm Password -->
               <div class="ts-form-group">
  <label asp-for="ConfirmPassword" class="ts-label">Confirm Password</label>
      <div class="ts-input-wrapper">
    <span class="material-symbols-outlined ts-input-icon">lock_reset</span>
         <input asp-for="ConfirmPassword" type="password" class="ts-input ts-input-with-icon" placeholder="••••••••" />
          </div>
 <span asp-validation-for="ConfirmPassword" class="ts-validation-error"></span>
              </div>

               <!-- Terms -->
 <div class="ts-checkbox-row ts-mt-md">
   <input type="checkbox" id="terms" name="terms" class="ts-checkbox" required />
        <label for="terms" class="ts-body-sm">
       I agree to the <a href="#" class="ts-link">Terms of Service</a> and <a href="#" class="ts-link">Privacy Policy</a>.
           </label>
               </div>

     <!-- Submit Button -->
        <div class="ts-mt-lg">
           <button type="submit" class="ts-btn ts-btn-primary ts-btn-w-full">
         Create Account
          </button>
            </div>
         </form>

           <div class="ts-mt-lg ts-text-center">
            <p class="ts-body-sm ts-text-secondary" style="margin: 0;">
         Already have an account?
<a asp-action="Login" asp-controller="Account" class="ts-link ts-label-md" style="margin-left: 0.25rem;">Sign in</a>
              </p>
       </div>
        </div>
       </div>
 </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
