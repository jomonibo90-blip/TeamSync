@model TeamSync.ViewModels.EditGroupViewModel
@{
    ViewData["Title"] = "Edit Group";
}

<div class="ts-page-header">
    <h1 class="ts-headline-lg-mobile md:ts-headline-lg">Edit Group</h1>
    <p class="ts-body-lg ts-text-secondary">Update the details or settings for @Model.Name.</p>
</div>

<div class="ts-dashboard-grid">
    <div class="ts-dashboard-card ts-col-span-2">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg">Group Settings</h3>
        </div>
        <div class="ts-dashboard-card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="ts-validation-error ts-mb-md"></div>

                <div class="ts-form-group">
                    <label asp-for="Name" class="ts-label"></label>
                    <div class="ts-input-wrapper">
                        <span class="material-symbols-outlined ts-input-icon">group</span>
                        <input asp-for="Name" class="ts-input ts-input-with-icon" />
                    </div>
                    <span asp-validation-for="Name" class="ts-validation-error"></span>
                </div>

                <div class="ts-form-group">
                    <label asp-for="Description" class="ts-label"></label>
                    <textarea asp-for="Description" class="ts-input" rows="4"></textarea>
                    <span asp-validation-for="Description" class="ts-validation-error"></span>
                </div>

                <div class="ts-form-group ts-checkbox-row ts-mt-md">
                    <input asp-for="IsActive" class="ts-checkbox" />
                    <label asp-for="IsActive">Group is Active</label>
                    <p class="ts-body-sm ts-text-secondary" style="font-size: 12px; margin-left: 1.5rem;">Unchecking this will archive the group.</p>
                </div>

                <div class="ts-flex ts-gap-md ts-mt-lg">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="ts-btn ts-btn-secondary">Cancel</a>
                    <button type="submit" class="ts-btn ts-btn-primary">
                        <span class="material-symbols-outlined" style="font-size: 18px;">save</span> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Security/Join Code settings -->
    <div>
        <div class="ts-dashboard-card ts-mb-md">
            <div class="ts-dashboard-card-header bg-error-container">
                <h3 class="ts-title-lg ts-flex ts-items-center ts-gap-sm">
                    <span class="material-symbols-outlined ts-text-error">key</span>
                    Security
                </h3>
            </div>
            <div class="ts-dashboard-card-body">
                <p class="ts-body-sm ts-text-secondary ts-mb-md">If your join code was leaked, you can regenerate it. Old codes will immediately stop working.</p>
                
                <form asp-action="RegenerateJoinCode" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to invalidate the old join code? Students will no longer be able to use it to join.');">
                    <button type="submit" class="ts-btn ts-btn-secondary" style="color: var(--ts-error); border-color: rgba(186, 26, 26, 0.3);">
                        <span class="material-symbols-outlined" style="font-size: 18px;">refresh</span> Regenerate Join Code
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}