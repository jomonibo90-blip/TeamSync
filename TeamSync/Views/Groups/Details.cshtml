@* Tasks section: simplified (no tracking/approval buttons) *@
@if (Model.ActiveTasks.Any())
{
    <div class="ts-dashboard-card" style="margin-bottom:1.5rem;">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg">Active Tasks (@Model.ActiveTasks.Count)</h3>
        </div>
        <div class="ts-dashboard-card-body">
            @foreach (var t in Model.ActiveTasks)
            {
                <div class="ts-requested-task-item">
                    <div class="ts-requested-task-row">
                        <div class="ts-requested-task-meta">
                            <div>
                                <strong>@t.Title</strong>
                                <div class="ts-body-sm ts-text-secondary">Assigned: @(t.AssignedToName ?? "Unassigned")</div>
                            </div>
                        </div>

                        <div class="ts-flex ts-items-center ts-gap-md">
                            <div class="ts-text-secondary">Due: @t.DueDate?.ToString("yyyy-MM-dd")</div>
                            @if (t.UpdatedAt.HasValue)
                            {
                                <div class="ts-text-secondary">Updated: @t.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                            }

                            @{ var currentUserId = (ViewBag.CurrentUserId as string) ?? string.Empty; }

                            @if (!string.IsNullOrEmpty(currentUserId) && currentUserId == t.AssignedToId)
                            {
                                if (t.Status == "Pending")
                                {
                                    <form asp-controller="Tasks" asp-action="SetInProgress" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:8px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="ts-btn ts-btn-sm ts-btn-primary">Start</button>
                                    </form>
                                }
                                else if (t.Status == "InProgress")
                                {
                                    <form asp-controller="Tasks" asp-action="RequestReview" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:8px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">Request Review</button>
                                    </form>
                                }
                            }

                            @* Card-level approver actions for review requests *@
                            @if (t.Status == "ReviewRequested" || t.Status == "LeadApproved")
                            {
                                var approveLabel = t.IsLeadForCurrentUser && !t.IsProfessorForCurrentUser ? "Lead Approve" : "Finalize";
                                <form asp-controller="Tasks" asp-action="ApproveCompletion" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:8px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="ts-btn ts-btn-sm ts-btn-success">@approveLabel</button>
                                </form>
                                <form asp-controller="Tasks" asp-action="RejectCompletion" method="post" class="js-disable-on-submit" style="display:inline-block; margin-left:4px;" onsubmit="return confirm('Reject completion?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">Reject</button>
                                </form>
                            }

                            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="ts-link" style="margin-left:12px;">Open</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Requested tasks section remains for professor/lead approval of student requests *@
@if (Model.RequestedTasks.Any() && (Model.CurrentUserRole == "Professor" || User.IsInRole("Admin") || Model.CurrentUserRole == "Lead"))
{
    <div class="ts-dashboard-card ts-requested-tasks-card">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg">Requested Tasks (@Model.RequestedTasks.Count)</h3>
        </div>
        <div class="ts-dashboard-card-body">
            @* Show inline messages specific to approval actions *@
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="ts-alert ts-alert-error">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="ts-alert ts-requested-warning">@TempData["WarningMessage"]</div>
            }

            @foreach (var t in Model.RequestedTasks)
            {
                <div class="ts-requested-task-item">
                    <div class="ts-requested-task-row">
                        <div class="ts-requested-task-meta">
                            <div>
                                <strong class="ts-requested-task-title">@t.Title</strong>
                                @if (t.Id > 0)
                                {
                                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="ts-link ts-requested-open-link">Open</a>
                                }
                                else
                                {
                                    <span class="ts-text-secondary ts-requested-open-link">Unavailable</span>
                                }
                            </div>
                            <div class="ts-body-sm ts-text-secondary">Requested by: @(t.CreatedByName ?? "Unknown")</div>
                        </div>

                        <div class="ts-requested-task-actions">
                            <form asp-controller="Tasks" asp-action="ApproveRequest" method="post" class="ts-requested-approve-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@t.Id" />

                                <label class="ts-label-sm ts-requested-field-label">Start</label>
                                <input type="date" name="startDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="ts-input ts-requested-start-input" />

                                <label class="ts-label-sm ts-requested-field-label">Due</label>
                                <input type="date" name="dueDate" value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")" class="ts-input ts-requested-due-input" required />

                                <select name="assignedToId" class="ts-input ts-requested-assignee-select">
                                    @if (!string.IsNullOrEmpty(t.CreatedById))
                                    {
                                        <option value="@t.CreatedById">@(t.CreatedByName ?? "Requester") (Requester)</option>
                                    }
                                    <option value="">Unassigned / choose member</option>
                                    @foreach (var member in Model.Members)
                                    {
                                        <option value="@member.UserId">@member.FullName (@member.Role)</option>
                                    }
                                </select>

                                <button type="submit" class="ts-btn ts-btn-sm ts-btn-success">Approve</button>
                            </form>

                            <form asp-controller="Tasks" asp-action="RejectRequest" method="post" class="ts-requested-reject-form" onsubmit="return confirm('Reject request?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@t.Id" />
                                <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="ts-dashboard-grid">
    <!-- Main Content Area -->
    <div class="ts-col-span-2">
        <div class="ts-dashboard-card">
            <div class="ts-dashboard-card-header">
                <h3 class="ts-title-lg">

                    Members (@Model.Members.Count)
                </h3>
            </div>
            <div class="ts-dashboard-card-body" style="padding: 0;">
                <ul style="list-style: none; padding: 0; margin: 0;">
                    @foreach (var member in Model.Members)
                    {
                        <li style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid var(--ts-border);">
                            <div class="ts-flex ts-items-center ts-gap-md">
                                <div class="ts-avatar">
                                    @(string.IsNullOrEmpty(member.FullName) ? "U" : member.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="ts-label-md">@member.FullName</div>
                                    <div class="ts-body-sm ts-text-secondary">@member.Email</div>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="display: flex; align-items: center; gap: 0.5rem; justify-content: flex-end;">
                                    <span style="display:inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; 
                                          @(member.Role == "Professor" ? "background: rgba(13,110,253,0.1); color: var(--ts-primary);" : 
                                            member.Role == "Lead" ? "background: rgba(25,135,84,0.1); color: var(--ts-success);" : 
                                            "background: var(--ts-surface-container-high); color: var(--ts-secondary);")">
                                        @member.Role
                                    </span>
                                    
                                    @* Action buttons *@
                                    @if (canManageMembers && member.Role != "Professor" && Model.IsActive)
                                    {
                                        <div style="display: flex; gap: 0.5rem;">
                                            @* Promote to Lead (only if not already Lead) *@
                                            @if (member.Role == "Member" && isProfessor)
                                            {
                                                <form asp-action="PromoteToLead" asp-route-groupId="@Model.Id" asp-route-userId="@member.UserId" method="post" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary" title="Promote to Lead">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">star</span>
                                                    </button>
                                                </form>
                                            }
                                            

                                            @* Remove button *@
                                            <button class="ts-btn ts-btn-sm ts-btn-danger" title="Remove Member" onclick="openRemoveModal('@member.UserId', '@member.FullName')">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">person_remove</span>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <div class="ts-label-sm ts-text-secondary ts-mt-sm">Joined @member.JoinedAt.ToString("MMM dd")</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    
    <!-- Sidebar Area -->
    <div>
        <div class="ts-dashboard-card" style="margin-bottom: 1.5rem;">
            <div class="ts-dashboard-card-header">
                <h3 class="ts-title-lg">Details</h3>
            </div>
            <div class="ts-dashboard-card-body">
                <div class="ts-mb-md">
                    <span class="ts-label-sm ts-text-secondary">Created On</span>
                    <div class="ts-body-md">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                </div>
                <div>
                    <span class="ts-label-sm ts-text-secondary">Status</span>
                    @if (Model.IsActive)
                    {
                        <div class="ts-body-md ts-flex ts-items-center ts-gap-sm" style="color: var(--ts-success);">
                            <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span> Active
                        </div>
                    }
                    else
                    {
                        <div class="ts-body-md ts-flex ts-items-center ts-gap-sm" style="color: #dc3545;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">archive</span> Archived
                        </div>
                        @if (Model.ArchivedAt.HasValue)
                        {
                            <div class="ts-body-sm ts-text-secondary ts-mt-xs">
                                on @Model.ArchivedAt.Value.ToString("MMMM dd, yyyy HH:mm")
                            </div>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="PurgeGroup" asp-route-id="@Model.Id" method="post" style="display: inline; margin-top: 0.5rem;" onsubmit="return confirm('This will permanently delete the group and all its data. This cannot be undone. Are you sure?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ts-btn ts-btn-sm ts-btn-danger" title="Permanently Delete Group">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">delete_forever</span> Purge Permanently
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>
