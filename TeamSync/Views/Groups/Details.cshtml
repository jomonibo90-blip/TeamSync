@* Leave Group Modal (for students and professors) *@
@if (isStudent || isProfessor)
{
    <div id="leaveGroupModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center;">
        <div style="background: var(--ts-surface); border-radius: var(--ts-radius-xl); width: 100%; max-width: 400px; margin: 10vh auto; padding: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
            <div class="ts-flex ts-justify-between ts-items-center ts-mb-lg">
                <h3 class="ts-title-lg" style="margin: 0;">Leave Group</h3>
                <button onclick="document.getElementById('leaveGroupModal').style.display='none'" style="background: none; border: none; cursor: pointer; color: var(--ts-secondary);">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <p class="ts-body-md ts-mb-md">Are you sure you want to leave <strong>@Model.Name</strong>?</p>

            @if (isProfessor)
            {
                <div id="professorWarning" class="ts-alert ts-alert-warning ts-mb-md" style="display: none; background: rgba(255,193,7,0.1); color: var(--ts-warning); border: 1px solid rgba(255,193,7,0.2); padding: 0.75rem;">
                    <strong>⚠️ Warning:</strong> You are the only professor in this group. Consider adding another professor before leaving.
                </div>
            }

            <form asp-action="RemoveMember" asp-route-groupId="@Model.Id" asp-route-userId="" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="leaveUserId" name="userId" />
                <input type="hidden" id="leaveReason" name="reason" value="@(isProfessor ? "Professor left the group" : "Student requested to leave group")" />

                <div class="ts-body-sm ts-text-secondary ts-mb-md">
                    <strong>Note:</strong> @(isProfessor ? "Your departure will be immediate." : "Your leave request will be sent to the professor for approval.")
                </div>

                <div class="ts-flex ts-gap-md ts-mt-lg" style="justify-content: flex-end;">
                    <button type="button" class="ts-btn ts-btn-secondary" onclick="document.getElementById('leaveGroupModal').style.display='none'">Cancel</button>
                    <button type="submit" class="ts-btn ts-btn-danger">Leave Group</button>
                </div>
            </form>
        </div>
    </div>
}

<div style="margin-top:1rem; margin-bottom:1rem; display:flex; gap:1rem; align-items:center;">
    <div style="background:var(--ts-surface); padding:0.75rem 1rem; border-radius:8px; border:1px solid var(--ts-border);">
        <div class="ts-label-sm ts-text-secondary">Total Hours Contributed</div>
        <div class="ts-title-md">@Model.TotalHoursContributed</div>
    </div>
    <div style="background:var(--ts-surface); padding:0.75rem 1rem; border-radius:8px; border:1px solid var(--ts-border);">
        <div class="ts-label-sm ts-text-secondary">Contributions</div>
        <div class="ts-title-md">@Model.ContributionsCount</div>
    </div>
</div>

<script>
function openRemoveModal(userId, memberName) {
    document.getElementById('userId').value = userId;
    document.getElementById('memberName').textContent = memberName;
    document.getElementById('removeMemberModal').style.display = 'flex';
}

function openLeaveModal() {
    document.getElementById('leaveGroupModal').style.display = 'flex';

    // Set current user ID if available
    const userIdFromPage = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
    if (userIdFromPage) {
        document.getElementById('leaveUserId').value = userIdFromPage;
    }

    // Check if user is professor and if they're the only one
    const isProfessor = @(isProfessor ? "true" : "false");
    if (isProfessor) {
        const professorCount = @Model.Members.Count(m => m.Role == "Professor");
        const warningDiv = document.getElementById('professorWarning');
        if (professorCount === 1 && warningDiv) {
            warningDiv.style.display = 'block';
        } else if (warningDiv) {
            warningDiv.style.display = 'none';
        }
    }
}

// Close modals when clicking outside
document.addEventListener('click', function(event) {
    const addModal = document.getElementById('addMemberModal');
    const removeModal = document.getElementById('removeMemberModal');
    const leaveModal = document.getElementById('leaveGroupModal');

    if (event.target === addModal) addModal.style.display = 'none';
    if (event.target === removeModal) removeModal.style.display = 'none';
    if (event.target === leaveModal) leaveModal.style.display = 'none';
});
</script>

@section Scripts {
    <script>
        // Disable submit buttons and show loading state to prevent double submits
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (form.classList && form.classList.contains('js-disable-on-submit')) {
                var btns = form.querySelectorAll('button[type=submit]');
                btns.forEach(function (b) { b.disabled = true; b.dataset.origHtml = b.innerHTML; b.innerHTML = 'Processing...'; });
            }
        });

        // Chat modal functions
        function openChatModal() {
            var modal = document.getElementById('chatModal');
            if (modal) modal.style.display = 'block';
            initializeChat();
        }

        function closeChatModal() {
            var modal = document.getElementById('chatModal');
            if (modal) modal.style.display = 'none';
            if (window.chatConnection) {
                window.chatConnection.stop();
            }
        }

        window.onclick = function (event) {
            var modal = document.getElementById('chatModal');
            if (event.target == modal) {
                modal.style.display = 'none';
            }
        }
    </script>

    <!-- Chat Modal -->
    <div id="chatModal" class="ts-modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.4);">
        <div class="ts-modal-content" style="background-color: var(--ts-surface); margin: auto; padding: 0; border: 1px solid var(--ts-border); border-radius: var(--ts-radius-lg); width: 90%; max-width: 600px; height: 600px; display: flex; flex-direction: column; margin-top: 5%;">
            <!-- Modal Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--ts-border);">
                <h2 class="ts-title-lg">@Model.Name - Group Chat</h2>
                <button type="button" onclick="closeChatModal()" style="background: none; border: none; font-size: 28px; cursor: pointer; color: var(--ts-text-secondary);">&times;</button>
            </div>

            <!-- Messages Container -->
            <div id="chatMessages" style="flex: 1; overflow-y: auto; padding: 1rem; background-color: var(--ts-background);">
                <div style="text-align: center; color: var(--ts-text-secondary); padding: 2rem;">
                    <p>Loading messages...</p>
                </div>
            </div>

            <!-- Message Input -->
            <div style="padding: 1rem; border-top: 1px solid var(--ts-border); display: flex; gap: 0.5rem;">
                <input type="text" id="messageInput" placeholder="Type a message..." class="ts-input" style="flex: 1;" />
                <button onclick="sendMessage()" class="ts-btn ts-btn-primary" style="padding: 0.5rem 1rem;">Send</button>
            </div>
        </div>
    </div>

    <!-- SignalR Script for Chat -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/signalr.min.js"></script>
    <script>
        window.chatConnection = null;
        const groupId = @Model.Id;

        async function initializeChat() {
            if (window.chatConnection && window.chatConnection.state === 'Connected') {
                loadChatHistory();
                return;
            }

            window.chatConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            window.chatConnection.on("ReceiveMessage", function (message) {
                displayMessage(message);
            });

            window.chatConnection.on("LoadHistoryResponse", function (messages) {
                clearMessages();
                messages.forEach(msg => displayMessage(msg));
                scrollToBottom();
            });

            window.chatConnection.onreconnected(async function () {
                console.log("Chat reconnected");
                loadChatHistory();
            });

            try {
                await window.chatConnection.start();
                await window.chatConnection.invoke("JoinGroupChat", groupId);
                loadChatHistory();
            } catch (err) {
                console.error("Chat connection error:", err);
            }
        }

        function displayMessage(message) {
            const container = document.getElementById('chatMessages');
            const msgDiv = document.createElement('div');
            msgDiv.style.marginBottom = '0.5rem';
            msgDiv.style.padding = '0.75rem';
            msgDiv.style.backgroundColor = 'var(--ts-surface)';
            msgDiv.style.borderRadius = 'var(--ts-radius-md)';
            msgDiv.style.borderLeft = '3px solid var(--ts-primary)';

            const time = new Date(message.createdAt).toLocaleTimeString();
            msgDiv.innerHTML = `
                <div style="font-weight: bold; color: var(--ts-primary); font-size: 0.9rem;">@User.Identity?.Name</div>
                <div style="color: var(--ts-text-primary); margin-top: 0.25rem;">${escapeHtml(message.content)}</div>
                <div style="font-size: 0.75rem; color: var(--ts-text-secondary); margin-top: 0.25rem;">${time}</div>
            `;
            container.appendChild(msgDiv);
            scrollToBottom();
        }

        function clearMessages() {
            document.getElementById('chatMessages').innerHTML = '';
        }

        function loadChatHistory() {
            if (window.chatConnection && window.chatConnection.state === 'Connected') {
                window.chatConnection.invoke("LoadHistory", groupId, 50);
            }
        }

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            if (!content) return;

            if (window.chatConnection && window.chatConnection.state === 'Connected') {
                window.chatConnection.invoke("SendMessage", groupId, content);
                input.value = '';
                input.focus();
            } else {
                console.error("Chat connection not ready");
            }
        }

        function scrollToBottom() {
            const container = document.getElementById('chatMessages');
            container.scrollTop = container.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Allow sending message with Enter key
        document.addEventListener('keyup', function (e) {
            if (e.key === 'Enter' && document.getElementById('messageInput') === document.activeElement) {
                sendMessage();
            }
        });
    </script>

}