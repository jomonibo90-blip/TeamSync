@model TeamSync.ViewModels.GroupDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    bool canManageMembers = Model.CurrentUserRole == "Professor" || Model.CurrentUserRole == "Lead" || User.IsInRole("Admin");
}

<div class="ts-page-header ts-flex ts-justify-between ts-items-center" style="flex-wrap: wrap; gap: 1rem;">
    <div>
        <div class="ts-flex ts-items-center ts-gap-sm ts-mb-sm">
            <span style="padding: 2px 6px; background: rgba(13,110,253,0.1); color: var(--ts-primary); border-radius: 4px; font-size: 12px; font-weight: bold; text-transform: uppercase;">
                @Model.CurrentUserRole
            </span>
        </div>
        <h1 class="ts-headline-lg-mobile md:ts-headline-lg">@Model.Name</h1>
        <p class="ts-body-lg ts-text-secondary">@Model.Description</p>
    </div>
    <div class="ts-flex ts-items-center ts-gap-sm">
        @if (canManageMembers)
        {
            <div style="background: var(--ts-surface); border: 1px dashed var(--ts-primary); padding: 0.5rem 1rem; border-radius: var(--ts-radius-lg); text-align: center; margin-right: 1rem;">
                <span class="ts-label-sm ts-text-secondary" style="display: block; margin-bottom: 2px;">Join Code</span>
                <span class="ts-title-lg ts-text-primary" style="letter-spacing: 2px; font-family: monospace;">@Model.JoinCode</span>
            </div>
            
            <button class="ts-btn ts-btn-secondary" onclick="document.getElementById('addMemberModal').style.display='block'">
                <span class="material-symbols-outlined" style="font-size: 18px;">person_add</span> Add Member
            </button>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ts-btn ts-btn-secondary" style="padding: 0.5rem;" title="Edit Group">
                <span class="material-symbols-outlined" style="font-size: 20px;">settings</span>
            </a>
        }
        else
        {
            <button class="ts-btn ts-btn-secondary">
                <span class="material-symbols-outlined" style="font-size: 18px;">chat</span> Message Group
            </button>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="ts-alert" style="background: rgba(25,135,84,0.1); color: var(--ts-success); border: 1px solid rgba(25,135,84,0.2);">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="ts-alert ts-alert-error">
        @TempData["ErrorMessage"]
    </div>
}

<div class="ts-dashboard-grid">
    <!-- Main Content Area -->
    <div class="ts-col-span-2">
        <div class="ts-dashboard-card">
            <div class="ts-dashboard-card-header">
                <h3 class="ts-title-lg">
                    <span class="material-symbols-outlined ts-text-primary" style="font-size: 20px;">group</span>
                    Members (@Model.Members.Count)
                </h3>
            </div>
            <div class="ts-dashboard-card-body" style="padding: 0;">
                <ul style="list-style: none; padding: 0; margin: 0;">
                    @foreach (var member in Model.Members)
                    {
                        <li style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid var(--ts-border);">
                            <div class="ts-flex ts-items-center ts-gap-md">
                                <div class="ts-avatar">
                                    @(string.IsNullOrEmpty(member.FullName) ? "U" : member.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="ts-label-md">@member.FullName</div>
                                    <div class="ts-body-sm ts-text-secondary">@member.Email</div>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <span style="display:inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; 
                                      @(member.Role == "Professor" ? "background: rgba(13,110,253,0.1); color: var(--ts-primary);" : 
                                        member.Role == "Lead" ? "background: rgba(25,135,84,0.1); color: var(--ts-success);" : 
                                        "background: var(--ts-surface-container-high); color: var(--ts-secondary);")">
                                    @member.Role
                                </span>
                                <div class="ts-label-sm ts-text-secondary ts-mt-sm">Joined @member.JoinedAt.ToString("MMM dd")</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    
    <!-- Sidebar Area -->
    <div>
        <div class="ts-dashboard-card" style="margin-bottom: 1.5rem;">
            <div class="ts-dashboard-card-header">
                <h3 class="ts-title-lg">Details</h3>
            </div>
            <div class="ts-dashboard-card-body">
                <div class="ts-mb-md">
                    <span class="ts-label-sm ts-text-secondary">Created On</span>
                    <div class="ts-body-md">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                </div>
                <div>
                    <span class="ts-label-sm ts-text-secondary">Status</span>
                    <div class="ts-body-md ts-flex ts-items-center ts-gap-sm ts-text-success">
                        <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span> Active
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (canManageMembers)
{
    <!-- Add Member Modal -->
    <div id="addMemberModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center;">
        <div style="background: var(--ts-surface); border-radius: var(--ts-radius-xl); width: 100%; max-width: 400px; margin: 10vh auto; padding: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
            <div class="ts-flex ts-justify-between ts-items-center ts-mb-lg">
                <h3 class="ts-title-lg" style="margin: 0;">Add Team Member</h3>
                <button onclick="document.getElementById('addMemberModal').style.display='none'" style="background: none; border: none; cursor: pointer; color: var(--ts-secondary);">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            
            <form asp-action="AddMember" method="post">
                <input type="hidden" name="GroupId" value="@Model.Id" />
                
                <div class="ts-form-group">
                    <label for="Email" class="ts-label">User Email Address</label>
                    <div class="ts-input-wrapper">
                        <span class="material-symbols-outlined ts-input-icon">mail</span>
                        <input type="email" name="Email" id="Email" class="ts-input ts-input-with-icon" placeholder="student@university.edu" required />
                    </div>
                    <p class="ts-body-sm ts-text-secondary ts-mt-sm" style="font-size: 12px;">They must already have an account on TeamSync.</p>
                </div>
                
                <div class="ts-flex ts-gap-md ts-mt-lg" style="justify-content: flex-end;">
                    <button type="button" class="ts-btn ts-btn-secondary" onclick="document.getElementById('addMemberModal').style.display='none'">Cancel</button>
                    <button type="submit" class="ts-btn ts-btn-primary">Add to Group</button>
                </div>
            </form>
        </div>
    </div>
}