@model TeamSync.ViewModels.GroupDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    bool canManageMembers = Model.CurrentUserRole == "Professor" || Model.CurrentUserRole == "Lead" || User.IsInRole("Admin");
    bool isProfessor = Model.CurrentUserRole == "Professor" || User.IsInRole("Admin");
    bool isStudent = Model.CurrentUserRole == "Member";

    string TaskStatusBadge(string status) => status switch
    {
        "LeadApproved" => "ts-badge ts-badge-lead",
        "ReviewRequested" => "ts-badge ts-badge-review",
        "Completed" => "ts-badge ts-badge-completed",
        "InProgress" => "ts-badge ts-badge-inprogress",
        _ => "ts-badge ts-badge-pending"
    };
}

<div class="ts-page-header ts-flex ts-justify-between ts-items-center" style="flex-wrap: wrap; gap: 1rem;">
    <div>
        <div class="ts-flex ts-items-center ts-gap-sm ts-mb-sm">
            <span style="padding: 2px 6px; background: rgba(13,110,253,0.1); color: var(--ts-primary); border-radius: 4px; font-size: 12px; font-weight: bold; text-transform: uppercase;">
                @Model.CurrentUserRole
            </span>
        </div>
        <h1 class="ts-headline-lg-mobile md:ts-headline-lg">@Model.Name</h1>
        <p class="ts-body-lg ts-text-secondary">@Model.Description</p>
    </div>
    <div class="ts-flex ts-items-center ts-gap-sm">
        @if (canManageMembers)
        {
            @if (Model.IsActive)
            {
                <div style="background: var(--ts-surface); border: 1px dashed var(--ts-primary); padding: 0.5rem 1rem; border-radius: var(--ts-radius-lg); text-align: center; margin-right: 1rem;">
                    <span class="ts-label-sm ts-text-secondary" style="display: block; margin-bottom: 2px;">Join Code</span>
                    <span class="ts-title-lg ts-text-primary" style="letter-spacing: 2px; font-family: monospace;">@Model.JoinCode</span>
                </div>
                
                <button class="ts-btn ts-btn-secondary" onclick="document.getElementById('addMemberModal').style.display='block'">
                    <span class="material-symbols-outlined" style="font-size: 18px;">person_add</span> Add Member
                </button>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="ts-btn ts-btn-secondary" style="padding: 0.5rem;" title="Edit Group">
                    <span class="material-symbols-outlined" style="font-size: 20px;">settings</span>
                </a>

                @* Task actions *@
                <a asp-controller="Tasks" asp-action="Create" asp-route-groupId="@Model.Id" class="ts-btn ts-btn-secondary" style="margin-left:8px;">
                    <span class="material-symbols-outlined" style="font-size:18px;">task</span> Create Task
                </a>
            }
            else
            {
                <div style="background: rgba(255,193,7,0.1); border: 1px solid rgba(255,193,7,0.2); padding: 0.75rem 1rem; border-radius: var(--ts-radius-md); color: var(--ts-warning); display: flex; align-items: center; gap: 0.5rem;">
                    <span class="material-symbols-outlined">archive</span>
                    <span class="ts-body-sm"><strong>This group is archived.</strong> Project has ended.</span>
                </div>
            }
            
            @if (isProfessor)
            {
                <form asp-action="DeleteGroup" asp-route-id="@Model.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to archive this group?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ts-btn ts-btn-danger" style="padding: 0.5rem;" title="@(Model.IsActive ? "Archive Group" : "Already Archived")" @(Model.IsActive ? "" : "disabled")>
                        <span class="material-symbols-outlined" style="font-size: 20px;">delete</span>
                    </button>
                </form>
            }
        }

        <!-- Message Group button - available to all group members -->
        <button class="ts-btn ts-btn-secondary" onclick="openChatModal()">
            <span class="material-symbols-outlined" style="font-size: 18px;">chat</span> Message Group
        </button>

        @if (!canManageMembers)
        {
            @if (isStudent || isProfessor)
            {
                @if (Model.IsActive)
                {
                    <a asp-controller="Tasks" asp-action="RequestTask" asp-route-groupId="@Model.Id" class="ts-btn ts-btn-secondary" style="margin-left:8px;">
                        <span class="material-symbols-outlined" style="font-size:18px;">assignment</span> Request Task
                    </a>
                }
                <button class="ts-btn ts-btn-secondary ts-btn-danger" onclick="openLeaveModal()">
                    <span class="material-symbols-outlined" style="font-size: 18px;">logout</span> Leave Group
                </button>
            }
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="ts-alert" style="background: rgba(25,135,84,0.1); color: var(--ts-success); border: 1px solid rgba(25,135,84,0.2);">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="ts-alert ts-alert-error">
        @TempData["ErrorMessage"]
    </div>
}

@* Show pending removal requests (only for professors/admins) *@
@if (isProfessor && Model.PendingRemovalRequests.Any())
{
    <div class="ts-dashboard-card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--ts-warning); background: rgba(255,193,7,0.05);">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg" style="color: var(--ts-warning);">
                <span class="material-symbols-outlined ts-text-warning" style="font-size: 20px;">pending_actions</span>
                Pending Removal Requests (@Model.PendingRemovalRequests.Count)
            </h3>
        </div>
        <div class="ts-dashboard-card-body">
            @foreach (var request in Model.PendingRemovalRequests)
            {
                <div style="padding: 1rem; margin-bottom: 1rem; background: var(--ts-surface); border-radius: var(--ts-radius-md); border-left: 3px solid var(--ts-warning);">
                    <div class="ts-flex ts-justify-between ts-items-start ts-mb-sm">
                        <div>
                            <div class="ts-label-md">
                                @(request.RequestType == "Leave" ? "Leave Request" : "Removal Request")
                            </div>
                            <div class="ts-body-sm ts-text-secondary ts-mt-xs">
                                @request.UserFullName requested by @request.RequestedByFullName on @request.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>
                        <span style="display:inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; background: rgba(255,193,7,0.1); color: var(--ts-warning);">
                            @request.Status
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(request.Reason))
                    {
                        <div class="ts-body-sm ts-text-secondary ts-mb-md">
                            <strong>Reason:</strong> @request.Reason
                        </div>
                    }
                    <div class="ts-flex ts-gap-md">
                        <form asp-action="ApproveMemberRemoval" asp-route-removalRequestId="@request.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ts-btn ts-btn-sm ts-btn-success">
                                <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Approve
                            </button>
                        </form>
                        <form asp-action="RejectMemberRemoval" asp-route-removalRequestId="@request.Id" method="post" style="display: inline;" onsubmit="return confirm('Reject this request?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">
                                <span class="material-symbols-outlined" style="font-size: 16px;">cancel</span> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Show pending add member requests (only for professors/admins) *@
@if (isProfessor && Model.PendingAddRequests.Any())
{
    <div class="ts-dashboard-card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--ts-info); background: rgba(13,110,253,0.05);">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg" style="color: var(--ts-info);">
                <span class="material-symbols-outlined ts-text-info" style="font-size: 20px;">person_add_alt</span>
                Pending Member Add Requests (@Model.PendingAddRequests.Count)
            </h3>
        </div>
        <div class="ts-dashboard-card-body">
            @foreach (var request in Model.PendingAddRequests)
            {
                <div style="padding: 1rem; margin-bottom: 1rem; background: var(--ts-surface); border-radius: var(--ts-radius-md); border-left: 3px solid var(--ts-info);">
                    <div class="ts-flex ts-justify-between ts-items-start ts-mb-sm">
                        <div>
                            <div class="ts-label-md">Add Member Request</div>
                            <div class="ts-body-sm ts-text-secondary ts-mt-xs">
                                @request.Email requested by @request.RequestedByFullName on @request.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>
                        <span style="display:inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; background: rgba(13,110,253,0.1); color: var(--ts-info);">
                            @request.Status
                        </span>
                    </div>
                    <div class="ts-flex ts-gap-md">
                        <form asp-action="ApproveAddMember" asp-route-addMemberRequestId="@request.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ts-btn ts-btn-sm ts-btn-success">
                                <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Approve
                            </button>
                        </form>
                        <form asp-action="RejectAddMember" asp-route-addMemberRequestId="@request.Id" method="post" style="display: inline;" onsubmit="return confirm('Reject this request?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">
                                <span class="material-symbols-outlined" style="font-size: 16px;">cancel</span> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Show pending join requests (only for professors/admins) *@
@if (isProfessor && Model.PendingJoinRequests.Any())
{
    <div class="ts-dashboard-card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--ts-success); background: rgba(25,135,84,0.05);">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg" style="color: var(--ts-success);">
                <span class="material-symbols-outlined ts-text-success" style="font-size: 20px;">person_check</span>
                Pending Join Requests (@Model.PendingJoinRequests.Count)
            </h3>
        </div>
        <div class="ts-dashboard-card-body">
            @foreach (var request in Model.PendingJoinRequests)
            {
                <div style="padding: 1rem; margin-bottom: 1rem; background: var(--ts-surface); border-radius: var(--ts-radius-md); border-left: 3px solid var(--ts-success);">
                    <div class="ts-flex ts-justify-between ts-items-start ts-mb-sm">
                        <div>
                            <div class="ts-label-md">Join Request</div>
                            <div class="ts-body-sm ts-text-secondary ts-mt-xs">
                                @request.UserFullName (@request.Email) on @request.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>
                        <span style="display:inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; background: rgba(25,135,84,0.1); color: var(--ts-success);">
                            @request.Status
                        </span>
                    </div>
                    <div class="ts-flex ts-gap-md">
                        <form asp-action="ApproveJoinRequest" asp-route-joinRequestId="@request.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ts-btn ts-btn-sm ts-btn-success">
                                <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Approve
                            </button>
                        </form>
                        <form asp-action="RejectJoinRequest" asp-route-joinRequestId="@request.Id" method="post" style="display: inline;" onsubmit="return confirm('Reject this request?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ts-btn ts-btn-sm ts-btn-secondary">
                                <span class="material-symbols-outlined" style="font-size: 16px;">cancel</span> Reject
                            </button>
