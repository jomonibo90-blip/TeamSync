@model TeamSync.ViewModels.CreateGroupViewModel
@{
    ViewData["Title"] = "Create Group";
}

<div class="ts-page-header">
    <h1 class="ts-headline-lg-mobile md:ts-headline-lg">Create New Group</h1>
    <p class="ts-body-lg ts-text-secondary">Start a new project and invite your team members.</p>
</div>

<div class="ts-dashboard-grid">
    <div class="ts-dashboard-card ts-col-span-2">
        <div class="ts-dashboard-card-header">
            <h3 class="ts-title-lg">Group Details</h3>
        </div>
        <div class="ts-dashboard-card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="ts-validation-error ts-mb-md"></div>

                <div class="ts-form-group">
                    <label asp-for="Name" class="ts-label"></label>
                    <div class="ts-input-wrapper">
                        <span class="material-symbols-outlined ts-input-icon">group</span>
                        <input asp-for="Name" class="ts-input ts-input-with-icon" placeholder="e.g. CS401 Frontend Team" />
                    </div>
                    <span asp-validation-for="Name" class="ts-validation-error"></span>
                </div>

                <div class="ts-form-group">
                    <label asp-for="Description" class="ts-label"></label>
                    <textarea asp-for="Description" class="ts-input" rows="4" placeholder="Briefly describe the purpose of this group or project..."></textarea>
                    <span asp-validation-for="Description" class="ts-validation-error"></span>
                </div>

                <div class="ts-flex ts-gap-md ts-mt-lg">
                    <a asp-action="Index" class="ts-btn ts-btn-secondary">Cancel</a>
                    <button type="submit" class="ts-btn ts-btn-primary">
                        <span class="material-symbols-outlined" style="font-size: 18px;">add</span> Create Group
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}